{
  "name": "@aginnovationaustralia/calculator-units",
  "version": "0.1.0",
  "description": "Type-safe units and value containers for building calculators, with extensible substances, units and unit relationships",
  "keywords": [
    "units",
    "units of measure",
    "typescript",
    "calculator",
    "emissions"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./units": {
      "types": "./dist/units/index.d.ts",
      "default": "./dist/units/index.js"
    },
    "./substances/greenhouse-gases": {
      "types": "./dist/substances/greenhouse-gases.d.ts",
      "default": "./dist/substances/greenhouse-gases.js"
    },
    "./substances/agriculture": {
      "types": "./dist/substances/agriculture.d.ts",
      "default": "./dist/substances/agriculture.js"
    },
    "./defaults": {
      "types": "./dist/defaults/index.d.ts",
      "default": "./dist/defaults/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run check:package",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "pnpm run check:package",
    "clean": "rm -rf dist",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.blank-slate.json",
    "lint": "eslint . && pnpm run check:types",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aginnovationaustralia/emissions-calculators.git",
    "directory": "packages/calculator-units"
  },
  "homepage": "https://github.com/aginnovationaustralia/emissions-calculators/tree/main/packages/calculator-units#readme",
  "bugs": {
    "url": "https://github.com/aginnovationaustralia/emissions-calculators/issues"
  },
  "author": "Agricultural Innovation Australia",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "decimal.js-light": "^2.5.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.7",
    "jest": "^30.5.2",
    "publint": "^0.3.24",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
