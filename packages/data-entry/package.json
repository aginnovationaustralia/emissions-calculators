{
  "name": "data-entry",
  "version": "1.0.0",
  "description": "Electron app for building equation-symbol data models stored in JSON",
  "main": "./dist/main/index.js",
  "exports": {
    ".": "./dist/main/index.js",
    "./normalize": "./dist/shared/normalizeUnicode.js"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build && pnpm run build:normalize",
    "build:normalize": "tsc -p tsconfig.normalize.json",
    "start": "electron-vite preview",
    "clean": "rm -rf dist",
    "check:types": "tsc --noEmit",
    "lint": "eslint . && pnpm run check:types",
    "test": "jest"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Agricultural Innovation Australia",
  "license": "CC-BY-4.0"
}
