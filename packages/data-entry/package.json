{
  "name": "data-entry",
  "version": "1.0.0",
  "description": "Electron app for building equation-symbol data models stored in JSON",
  "main": "./dist/main/index.js",
  "exports": {
    ".": "./dist/main/index.js",
    "./normalize": "./dist/shared/normalizeUnicode.js"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build && pnpm run build:normalize",
    "build:normalize": "tsc -p tsconfig.normalize.json",
    "start": "electron-vite preview",
    "clean": "rm -rf dist",
    "check:types": "tsc --noEmit",
    "lint": "eslint . && pnpm run check:types",
    "test": "jest"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-vite": "^5.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Agricultural Innovation Australia",
  "license": "CC-BY-4.0"
}
