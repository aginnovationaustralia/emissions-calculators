  ],
  "scripts": {
    "build": "pnpm run clean && rollup -c && tsc-alias -p tsconfig.json && pnpm run fix:declarations && pnpm run check:package && pnpm run generate:openapi",
    "fix:declarations": "tsx scripts/fix-declaration-imports.ts",
    "check:package": "publint && attw --pack .",
    "check:browser-deps": "depcruise src --config .dependency-cruiser.cjs",
    "prepublishOnly": "pnpm run check:package",
    "dev": "rollup -c --watch",
    "clean": "rm -rf dist",
    "check:types": "tsc --noEmit",
    "lint": "eslint . && pnpm run check:types && pnpm run check:browser-deps",
    "test": "jest",
    "test:fullcam": "jest --config jest.config.fullcam.cjs",
    "version": "npm version --no-git-tag-version",
    "build:docs": "tsx scripts/build-docs/index.ts",
    "generate:exports": "tsx scripts/generate-exports.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi-breaking": "tsx scripts/check-openapi-breaking.ts",
    "dump:sheet": "tsx scripts/dump-test-sheet.ts",
    "prepare:release": "pnpm run build && pnpm run generate:exports && pnpm run generate:openapi && pnpm run check:openapi-breaking",
    "sync:ngaf": "tsx scripts/sync-ngaf/index.ts"
  },
