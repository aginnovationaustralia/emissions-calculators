{
  "name": "@aginnovationaustralia/emissions-calculators-tools",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "test": "turbo test",
    "build": "turbo build",
    "lint": "pnpm --filter @aginnovationaustralia/eslint-plugin-emissions-calculators build && turbo lint",
    "clean": "turbo clean",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "publish:dry": "pnpm build && pnpm -r publish --filter=@aginnovationaustralia/emissions-calculators --no-git-checks --access private --dry-run && pnpm -r publish --filter=@aginnovationaustralia/emissions-calculator-research --no-git-checks --access public --dry-run",
    "publish:packages": "pnpm -r publish --filter=@aginnovationaustralia/emissions-calculators --no-git-checks --access private --force",
    "version:bump": "pnpm -r version",
    "publish:research": "pnpm -r publish --filter=@aginnovationaustralia/emissions-calculator-research --no-git-checks --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aginnovationaustralia/emissions-calculators.git"
  },
  "author": "Agricultural Innovation Australia",
  "license": "CC-BY-4.0",
  "bugs": {
    "url": "https://github.com/aginnovationaustralia/emissions-calculators/issues"
  },
  "homepage": "https://github.com/aginnovationaustralia/emissions-calculators#readme",
  "description": "",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "data-entry": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-jest": "^29.16.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript-eslint": "^8.70.0",
    "@aginnovationaustralia/eslint-plugin-emissions-calculators": "workspace:*",
    "typescript": "^5.9.3"
  }
}
