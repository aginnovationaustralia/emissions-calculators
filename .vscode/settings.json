  "achilleshr.runonsave": {
    "commands": [
      {
        "match": ".*\\.ts$",
        "notMatch": "excelExport.ts",
        "cmd": "node ${workspaceFolder}/scripts/normalize-unicode-to-ascii.js ${file} && ${workspaceFolder}/node_modules/.bin/prettier --write ${file}"
      }
    ]
  },
