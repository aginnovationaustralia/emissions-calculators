{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    "packages/calculators": {
      "changelog-path": "packages/calculators/CHANGELOG.md",
      "release-type": "node",
      "include-component-in-tag": false,
      "include-v-in-tag": true
    },
    "packages/emissions-calculator-research": {
      "changelog-path": "CHANGELOG.md",
      "release-type": "node",
      "component": "emissions-calculator-research",
      "include-component-in-tag": true,
      "include-v-in-tag": true
    },
    "packages/veerg-calculators": {
      "changelog-path": "CHANGELOG.md",
      "release-type": "node",
      "component": "veerg-calculators",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "prerelease": true,
      "versioning": "prerelease",
      "prerelease-type": "beta",
      "release-as": "1.0.0-beta.1"
    }
  },
  "pull-request-title-pattern": "chore(main): release ${version}"
}
