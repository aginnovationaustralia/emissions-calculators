{
  "name": "examples-ts-client",
  "version": "1.0.0",
  "description": "TypeScript client example for @aginnovationaustralia/emissions-calculators",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "check:types": "tsc --noEmit",
    "lint": "eslint . && pnpm run check:types",
    "dev": "CALCULATOR_METRICS_ORGANISATION='ts-client example' ts-node src/index.ts",
    "units:generics": "ts-node src/units/calculator-units/index.ts",
    "units:generics:pitfall": "ts-node --transpile-only src/units/calculator-units/pitfall.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aginnovationaustralia/calculator-units": "workspace:*",
    "@aginnovationaustralia/emissions-calculator-research": "workspace:*",
    "@aginnovationaustralia/emissions-calculators": "workspace:*",
    "@aginnovationaustralia/veerg-calculators": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "typescript": "^6.0.3",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Agricultural Innovation Australia",
  "license": "CC-BY-4.0"
}
